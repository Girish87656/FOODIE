# ============================================================================
# Foodie — environment variable template
# ----------------------------------------------------------------------------
# Copy to `.env` (or `.env.local`) and fill in ONLY what you have. Every value
# here is optional; leaving the Supabase block empty keeps the app in its
# clearly-labelled DEMO DATA mode. NEVER commit a filled-in .env to git.
#
# Naming rules (enforced in src/lib/supabase/config.ts):
#   * ONLY browser-safe (publishable/anon) keys may appear in NEXT_PUBLIC_*
#     variables. They are visible in every browser bundle by design.
#   * A service-role/secret key must NEVER appear in this file, in any
#     NEXT_PUBLIC_* variable, or anywhere in this codebase — the app has no
#     service-role path at all (Row Level Security is the only enforcement).
# ============================================================================

# --- Supabase (browser-safe public values only) -----------------------------
# Project Settings → API in the Supabase dashboard.
# URL looks like: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Current Supabase naming for the browser-safe key (sb_publishable_… or the
# legacy anon JWT). Either variable below works; the publishable name wins.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Web Push (SERVER-ONLY secrets — never NEXT_PUBLIC_*, never in bundles) -
# Generate with: bunx web-push generate-vapid-keys
# The public key is served to browsers by /api/push/config (public by design);
# the private key and subject never leave the server.
# SUBJECT format: a contact URL — mailto:you@example.com or https://… .
# Push stays honestly disabled (configured:false) until all three are set.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
