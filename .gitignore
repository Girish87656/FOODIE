# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# but the committed, empty template IS meant to be versioned:
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# Scratch files (ANCHORED to the repo root — a bare "test"/"prompt" here once
# silently ignored src/app/api/push/test/, so the push delivery route was
# never committed by three consecutive sessions. Never use unanchored names.)
/test
/prompt

server.log
# Skills directory
/skills/
/tool-results
*.bundle
